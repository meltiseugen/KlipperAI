[Unit]
Description=KlipperAI agent
After=network-online.target moonraker.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/KlipperAI
EnvironmentFile=-/etc/klipperai/klipperai.env
ExecStart=/home/pi/KlipperAI/.venv/bin/klipperai-agent
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
